{
  "manifest_version": 3,
  "name": "RTL Fix - Arabic Text Direction",
  "version": "4.1.0",
  "description": "إصلاح اتجاه النص العربي مع لوحة تحكم كاملة",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RTL Fix"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
